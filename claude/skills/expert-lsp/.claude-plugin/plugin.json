{
  "name": "expert-lsp",
  "description": "Elixir language server via Expert (https://expert-lsp.org)",
  "version": "1.0.0",
  "lspServers": {
    "elixir": {
      "command": "expert-shim",
      "args": [],
      "extensionToLanguage": {
        ".ex": "elixir",
        ".exs": "elixir",
        ".heex": "heex"
      },
      "diagnostics": true,
      "restartOnCrash": true
    }
  }
}
